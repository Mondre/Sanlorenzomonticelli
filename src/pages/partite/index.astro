---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SportsFeed from '../../components/public/SportsFeed';
import MatchCard from '../../components/public/MatchCard';
import {database} from '../../server/db/client';
import {contentService} from '../../server/content/service';
import {filtersFrom,pageFailure,pageLink} from '../../server/content/public';
import type {Page,Match} from '../../shared/content';
export const prerender=false;
let data:Page<Match>|undefined;
let categories:{id:string;name:string}[]=[];
let filters:ReturnType<typeof filtersFrom>|undefined;
let error:ReturnType<typeof pageFailure>|undefined;
try{filters=filtersFrom(Astro.url);const service=contentService(database());[data,categories]=await Promise.all([service.listPublicMatches(filters),service.publicCategories()]);}catch(e){error=pageFailure(e);Astro.response.status=error.status;}
---
<BaseLayout title="Calendario e risultati"><section class="container section"><p class="eyebrow">OGNI PARTITA, INSIEME</p><h1 class="page-title">Calendario e risultati.</h1><p class="lead">Segui le squadre della società, giornata dopo giornata.</p>{!error&&!filters?.categoryId&&<SportsFeed client:load mode="matches" filter={filters?.mode??'all'}/>}<h2>Calendario gestito dalla società</h2><form class="public-filters" method="get"><label>Categoria<select name="category"><option value="">Tutte le categorie</option>{categories?.map(c=><option value={c.id} selected={filters?.categoryId===c.id}>{c.name}</option>)}</select></label><label>Partite<select name="mode"><option value="all" selected={filters?.mode==='all'}>Tutte</option><option value="upcoming" selected={filters?.mode==='upcoming'}>Prossime partite</option><option value="results" selected={filters?.mode==='results'}>Risultati</option></select></label><button class="button button-secondary">Applica filtri</button></form>{error?<p class="notice" role="status">{error.message}</p>:data&&<>{data.items.length?<div class="values-grid">{data.items.map(match=><MatchCard match={match}/>)}</div>:<p class="empty-state">Nessuna partita per i filtri selezionati.</p>}<nav class="pagination" aria-label="Pagine del calendario">{data.page>1&&<a class="button" href={pageLink(Astro.url,data.page-1)}>Precedenti</a>}<span>Pagina {data.page}</span>{data.hasMore&&<a class="button" href={pageLink(Astro.url,data.page+1)}>Successive</a>}</nav></>}</section></BaseLayout>
