---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {database} from '../../server/db/client';
import {contentService} from '../../server/content/service';
import {pageFailure} from '../../server/content/public';
import {formatDate,statusLabels} from '../../shared/content';
import {z} from 'zod';
export const prerender=false;
let match,error;
try{const id=z.uuid().safeParse(Astro.params.id);if(id.success)match=await contentService(database()).match(id.data);if(!match)Astro.response.status=404;}catch(e){error=pageFailure(e);Astro.response.status=error.status;}
const maps=match?.address?'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent([match.venue,match.address,match.city].filter(Boolean).join(', ')):null;
---
<BaseLayout title={match?`${match.homeTeam} – ${match.awayTeam}`:'Partita non disponibile'}><section class="container section"><a class="text-link" href="/partite">← Calendario e risultati</a>{error?<p class="notice" role="status">{error.message}</p>:match?<><p class="eyebrow">{match.category} · {match.competition} · {match.season}</p><span class="pill">{statusLabels[match.status]}</span><h1 class="page-title match-title">{match.homeTeam}<strong>{match.homeScore??'–'} : {match.awayScore??'–'}</strong>{match.awayTeam}</h1><div class="panel match-information"><p><strong>Data e ora:</strong> {formatDate(match.kickoff)}</p><p><strong>Campo:</strong> {match.venue??'Da definire'}</p>{match.address&&<p>{match.address}, {match.city}</p>}{match.round&&<p><strong>Giornata:</strong> {match.round}</p>}{maps&&<a class="button button-secondary" href={maps} target="_blank" rel="noopener noreferrer">Indicazioni per il campo ↗</a>}</div>{match.report&&<section class="article-page"><h2>La partita</h2><div class="article-body">{match.report}</div></section>}<p class="notice">Questa scheda mostra i dati disponibili all’apertura. Ricarica la pagina per gli aggiornamenti.</p></>:<><h1 class="page-title">Partita non trovata.</h1><p>Consulta il calendario per le partite disponibili.</p></>}</section></BaseLayout>
