---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MatchCard from '../../components/public/MatchCard';
import NewsCard from '../../components/public/NewsCard';
import {database} from '../../server/db/client';
import {teamService} from '../../server/teams/service';
import {contentService} from '../../server/content/service';
import {pageFailure} from '../../server/content/public';
import {z} from 'zod';
export const prerender=false;
let data:Awaited<ReturnType<ReturnType<typeof teamService>['publicCategory']>>=null;
let games:Awaited<ReturnType<ReturnType<typeof contentService>['listPublicMatches']>>|undefined;
let articles:Awaited<ReturnType<ReturnType<typeof contentService>['listPublicNews']>>|undefined;
let error:ReturnType<typeof pageFailure>|undefined;
try{const season=Astro.url.searchParams.get('season')||undefined;if(season)z.uuid().parse(season);const db=database();data=await teamService(db).publicCategory(Astro.params.slug??'',season);if(!data)Astro.response.status=404;else [games,articles]=await Promise.all([contentService(db).listPublicMatches({categoryId:data.category.id,seasonId:data.season.id}),contentService(db).listPublicNews({categoryId:data.category.id})]);}catch(e){error=pageFailure(e);Astro.response.status=error.status;}
---
<BaseLayout title={data?.category.name??'Squadra non disponibile'}><section class="container section"><a href="/squadre" class="text-link">← Tutte le squadre</a>{error?<p class="notice" role="status">{error.message}</p>:data?<><p class="eyebrow">STAGIONE {data.season.name}</p><h1 class="page-title">{data.category.name}</h1>{data.category.description&&<p class="lead">{data.category.description}</p>}<form class="public-filters" method="get"><label>Archivio stagioni<select name="season">{data.seasons.map(s=><option value={s.id} selected={s.id===data!.season.id}>{s.name}</option>)}</select></label><button class="button button-secondary">Mostra stagione</button></form>{data.teams.map(team=><section class="panel team-information"><h2>{team.name}</h2>{team.description&&<div class="article-body">{team.description}</div>}{team.trainingSchedule&&<><h3>Allenamenti</h3><div class="article-body">{team.trainingSchedule}</div></>}<h3>Staff</h3>{data!.staff.some(st=>st.teamId===team.id)?<ul class="staff-list">{data!.staff.filter(st=>st.teamId===team.id).map(st=><li><strong>{st.name}</strong> · {st.role}</li>)}</ul>:<p>Informazioni sullo staff non ancora pubblicate.</p>}{data!.players.some(player=>player.teamId===team.id)&&<><h3>La rosa</h3><ul class="staff-list">{data!.players.filter(player=>player.teamId===team.id).map(player=><li>{player.number&&<span class="pill">{player.number}</span>} <strong>{player.name}</strong> {player.position&&<>· {player.position}</>}</li>)}</ul></>}</section>)}{data.category.isYouth&&<p class="notice">Per tutelare i più piccoli, questa pagina non pubblica la rosa o fotografie dei giocatori minorenni.</p>}<section class="section"><div class="section-heading"><h2>Calendario e risultati</h2><a class="text-link" href={'/partite?category='+data.category.id}>Tutte le partite →</a></div>{games?.items.length?<div class="values-grid">{games.items.slice(0,6).map(match=><MatchCard match={match}/>)}</div>:<p class="empty-state">Nessuna partita ancora pubblicata per questa stagione.</p>}</section><section><div class="section-heading"><h2>Notizie della categoria</h2><a class="text-link" href={'/notizie?category='+data.category.id}>Tutte le notizie →</a></div>{articles?.items.length?<div class="values-grid">{articles.items.slice(0,3).map(article=><NewsCard article={article}/>)}</div>:<p class="empty-state">Nessuna notizia ancora pubblicata.</p>}</section><div class="panel club-callout"><h2>Informazioni e prove</h2><p>La segreteria può aiutarti a conoscere meglio questa categoria.</p><a class="button button-secondary" href="/richieste">Richiedi informazioni</a></div></>:<><h1 class="page-title">Squadra non trovata.</h1><p>La categoria o la stagione non è disponibile.</p></>}</section></BaseLayout>
