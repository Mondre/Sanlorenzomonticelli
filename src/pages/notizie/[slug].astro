---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {database} from '../../server/db/client';
import {contentService} from '../../server/content/service';
import {pageFailure} from '../../server/content/public';
import {formatDate} from '../../shared/content';
export const prerender=false;
let article,error;
try{article=await contentService(database()).article(Astro.params.slug??'');if(!article)Astro.response.status=404;}catch(e){error=pageFailure(e);Astro.response.status=error.status;}
const share=Astro.site?new URL(Astro.url.pathname,Astro.site).toString():null;
---
<BaseLayout title={article?.title??'Notizia non disponibile'} description={article?.excerpt}><section class="container section article-page"><a class="text-link" href="/notizie">← Tutte le notizie</a>{error?<p class="notice" role="status">{error.message}</p>:article?<article><p class="eyebrow">{article.categoryName??'Società'}</p><h1 class="page-title">{article.title}</h1><p><time datetime={article.publishAt??undefined}>{formatDate(article.publishAt)}</time></p><p class="lead">{article.excerpt}</p>{article.coverUrl&&<img class="article-cover" src={article.coverUrl} alt={article.coverAlt??''} width="1200" height="800" decoding="async" referrerpolicy="no-referrer"/>}<div class="article-body">{article.body}</div>{share&&<a class="button button-secondary" href={'https://wa.me/?text='+encodeURIComponent(article.title+' '+share)} rel="noopener noreferrer" target="_blank">Condividi su WhatsApp ↗</a>}</article>:<><h1 class="page-title">Notizia non trovata.</h1><p>La notizia potrebbe non essere ancora pubblicata.</p></>}</section></BaseLayout>
