---
import BaseLayout from '../layouts/BaseLayout.astro';
import { club } from '../config/club';
---
<BaseLayout title="Il calcio che ci unisce">
<section class="hero" aria-labelledby="hero-title"><div class="container hero-inner"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> LA PASSIONE HA CASA QUI</p><h1 id="hero-title">Una squadra.<br/>Un paese.<br/><em>Una passione.</em></h1><p>{club.description}</p><div class="actions"><a class="button button-primary" href="#societa">Conosci il progetto <span aria-hidden="true">↗</span></a><a class="button button-outline" href="#progetto">Cosa stiamo costruendo <span aria-hidden="true">↓</span></a></div></div><div class="hero-mark" aria-hidden="true"><img src={club.logo} width="240" height="240" alt=""/><span>INSIEME, IN CAMPO.</span></div></div><div class="hero-bottom container"><span>IL VALORE DELLA SQUADRA, DENTRO E FUORI DAL CAMPO</span><span>PASSIONE / RISPETTO / COMUNITÀ</span></div></section>
<div class="status-strip"><div class="container"><span class="status-badge">IL NUOVO PORTALE</span><p>Stiamo preparando uno spazio per tutta la nostra comunità.</p><a href="#progetto">Scopri le prossime tappe <span aria-hidden="true">→</span></a></div></div>
<section class="section container" id="societa"><div class="section-heading"><div><p class="eyebrow">MOLTO PIÙ DI NOVANTA MINUTI</p><h2>Il nostro modo di vivere il calcio.</h2></div><p>Un progetto dedicato a chi gioca, a chi insegna e a chi ci sostiene ogni domenica.</p></div><div class="values-grid"><article class="value-card"><span class="card-number">01 /</span><h3>La prima squadra</h3><p>Un punto di riferimento per la comunità. Risultati, calendario e protagonisti avranno uno spazio dedicato.</p><span class="pill">Modulo previsto</span></article><article class="value-card"><span class="card-number">02 /</span><h3>Crescere insieme</h3><p>Il settore giovanile al centro, con attenzione alle persone, al divertimento e alla tutela dei più piccoli.</p><span class="pill">Modulo previsto</span></article><article class="value-card accent-card"><span class="card-number">03 /</span><h3>Una sola comunità</h3><p>Famiglie, volontari e sostenitori. Il nuovo portale renderà più semplice sentirsi parte della squadra.</p><span class="pill">Modulo previsto</span></article></div></section>
<section class="project-section" id="progetto"><div class="container section"><div class="section-heading"><div><p class="eyebrow">PASSO DOPO PASSO</p><h2>Le fondamenta del nuovo portale.</h2></div><a href="/design-system" class="text-link">Esplora il design system ↗</a></div><div class="roadmap"><article><span class="phase active">01</span><div><h3>Identità e struttura</h3><p>Design system, navigazione responsive e architettura del progetto.</p><span class="pill">Questa versione</span></div></article><article><span class="phase">02</span><div><h3>Dati e area riservata</h3><p>Database Neon, autenticazione e permessi verificati sul server.</p><span class="pill">Da implementare</span></div></article><article><span class="phase">03</span><div><h3>Il club, ogni giorno</h3><p>Calendari, notizie, squadre e strumenti per la segreteria.</p><span class="pill">Da implementare</span></div></article></div></div></section>
</BaseLayout>
