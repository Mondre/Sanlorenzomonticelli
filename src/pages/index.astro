---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeFeed from '../components/public/HomeFeed';
import { club } from '../config/club';
---
<BaseLayout title="Il calcio che ci unisce">
<section class="hero" aria-labelledby="hero-title"><div class="container hero-inner"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> LA PASSIONE HA CASA QUI</p><h1 id="hero-title">Una squadra.<br/>Un paese.<br/><em>Una passione.</em></h1><p>{club.description}</p><div class="actions"><a class="button button-primary" href="/partite">Calendario e risultati <span aria-hidden="true">↗</span></a><a class="button button-outline" href="/notizie">Notizie dal club <span aria-hidden="true">↓</span></a></div></div><div class="hero-mark" aria-hidden="true"><img src={club.logo} width="240" height="240" alt=""/><span>INSIEME, IN CAMPO.</span></div></div><div class="hero-bottom container"><span>IL VALORE DELLA SQUADRA, DENTRO E FUORI DAL CAMPO</span><span>PASSIONE / RISPETTO / COMUNITÀ</span></div></section>
<HomeFeed client:load/><noscript><section class="container section"><p>Consulta <a href="/partite">calendario e risultati</a> e <a href="/notizie">notizie</a> nelle sezioni dedicate.</p></section></noscript>
<section class="section container" id="societa"><div class="section-heading"><div><p class="eyebrow">MOLTO PIÙ DI NOVANTA MINUTI</p><h2>Il nostro modo di vivere il calcio.</h2></div><p>Un progetto dedicato a chi gioca, a chi insegna e a chi ci sostiene ogni domenica.</p></div><div class="values-grid"><article class="value-card"><span class="card-number">01 /</span><h3>La prima squadra</h3><p>Un punto di riferimento per la comunità. Risultati, calendario e protagonisti in uno spazio dedicato.</p><span class="pill">Passione e comunità</span></article><article class="value-card"><span class="card-number">02 /</span><h3>Crescere insieme</h3><p>Il settore giovanile al centro, con attenzione alle persone, al divertimento e alla tutela dei più piccoli.</p><span class="pill">Passione e comunità</span></article><article class="value-card accent-card"><span class="card-number">03 /</span><h3>Una sola comunità</h3><p>Famiglie, volontari e sostenitori. Il nuovo portale renderà più semplice sentirsi parte della squadra.</p><span class="pill">Passione e comunità</span></article></div></section>
</BaseLayout>
